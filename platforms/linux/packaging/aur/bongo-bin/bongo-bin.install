post_install() {
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
    update-desktop-database -q 2>/dev/null || true
    echo ""
    echo ":: Bongo installed successfully!"
    echo "   * GNOME (IBus): Add 'Bangla (Bongo)' in Settings -> Keyboard -> Input Sources."
    echo "   * KDE / Hyprland (Fcitx5): Run 'bongo-fcitx5-setup' or add Bongo via Fcitx5 Configuration."
    echo "   * Settings & Layout: Launch 'bongo-settings' or open Bongo from your application menu."
    echo ""
}

post_upgrade() {
    post_install
}

post_remove() {
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
    update-desktop-database -q 2>/dev/null || true
}
