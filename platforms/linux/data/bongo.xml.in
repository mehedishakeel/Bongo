<?xml version="1.0" encoding="utf-8"?>
<!-- filename: bongo.xml -->
<!-- XML specification for iBus -->
<component>
    <name>org.freedesktop.IBus.Bongo</name>
    <description>Bongo</description>
    <exec>@PROJECT_DATADIR@/ibus-bongo --ibus</exec>
    <version>@PROJECT_VERSION@</version>
    <author>Mehedi Shakeel</author>
    <license>GPL 3</license>
    <homepage>@BONGO_HOMEPAGE@</homepage>
    <textdomain>bongo</textdomain>
    <engines>
        <engine>
            <name>Bongo</name>
            <language>bn</language>
            <license>GPL 3</license>
            <author>Mehedi Shakeel</author>
            <icon>@PROJECT_DATADIR@/icons/Bongo.png</icon>
            <layout>default</layout>
            <longname>Bongo</longname>
            <description>Bongo IME for iBus</description>
            <rank>0</rank>
        </engine>
    </engines>
</component>
