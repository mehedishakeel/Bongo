<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive Launcher Icon (Android 8.0 / API 26+)
    The system clips this to the device-specific shape (circle, squircle, etc.)
    Foreground: ic_launcher_foreground  (the Bongo drum logo with safe-zone padding)
    Background: ic_launcher_background  (solid brand colour)
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
